def _table_row_chunks(doc_id: str, page: int, heading_path: str, table_data: dict, doc_offset: int):
    """Flatten a docling table grid into one text chunk per row.

    Cells that span multiple rows/cols are repeated across every position
    they cover in the grid, so we dedup by each cell's top-left anchor
    (start_row_offset_idx, start_col_offset_idx) before joining.
    """
    grid = table_data.get("grid", [])
    row_texts = []
    for row in grid:
        seen_anchors = set()
        cell_texts = []
        for cell in row:
            text = (cell.get("text") or "").strip()
            if not text:
                continue
            anchor = (cell.get("start_row_offset_idx"), cell.get("start_col_offset_idx"))
            if anchor in seen_anchors:
                continue
            seen_anchors.add(anchor)
            cell_texts.append(text)
        if cell_texts:
            row_texts.append(" | ".join(cell_texts))

    new_chunks = []
    offset = doc_offset
    for row_text in row_texts:
        char_start = offset
        char_end = offset + len(row_text)
        offset = char_end
        new_chunks.append({
            "chunk_id": _chunk_id(doc_id, char_start, char_end),
            "doc_id": doc_id,
            "heading_path": heading_path,
            "page": page,
            "char_start": char_start,
            "char_end": char_end,
            "text": row_text,
        })
    return new_chunks, offset
